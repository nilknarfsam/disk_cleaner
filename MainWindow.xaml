<Window x:Class="Limpador_USB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Limpador / Formatador de HD e SSD USB"
        Height="680" Width="1080"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFC"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- DataTemplate para barra gráfica de espaço usado -->
        <DataTemplate x:Key="CapacityProgressTemplate">
            <Grid Margin="2,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0" Value="{Binding UsedPercentage}" Maximum="100" Height="14" 
                             Foreground="#3B82F6" Background="#E5E7EB" BorderThickness="0"/>
                <TextBlock Grid.Column="1" Text="{Binding UsedStr}" Margin="6,0,0,0" FontSize="11" 
                           VerticalAlignment="Center" FontWeight="SemiBold"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="MainRootGrid" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Topo: Título + Botão de Tema -->
        <DockPanel Grid.Row="0" Margin="0,0,0,4">
            <Button x:Name="BtnTheme" Content="🌙 Modo Escuro" Click="BtnTheme_Click" 
                    Padding="10,4" DockPanel.Dock="Right" FontWeight="SemiBold" Background="#E5E7EB"/>
            <TextBlock x:Name="TxtTitle" Text="Limpador / Formatador de HD e SSD conectados via USB" 
                       FontSize="18" FontWeight="Bold" Foreground="#111827"/>
        </DockPanel>

        <!-- Alerta -->
        <TextBlock Grid.Row="1" Text="Atenção: esta ferramenta apaga permanentemente os discos selecionados. Use somente em HD/SSD externo via USB." 
                   Foreground="#9A0000" FontWeight="Bold" FontSize="11.5" Margin="0,2,0,10"/>

        <!-- Barra de Pesquisa Rápida -->
        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="🔍 Pesquisar:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtSearch" TextChanged="TxtSearch_TextChanged" Height="28" Padding="6,2" 
                     ToolTip="Digite o nome, número do disco ou letra para filtrar..."/>
        </DockPanel>

        <!-- Tabela de Discos DataGrid -->
        <DataGrid Grid.Row="3" x:Name="GridDisks" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" SelectionMode="Extended" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB"
                  Background="White" RowHeaderWidth="0" FontSize="12"
                  MouseLeftButtonUp="GridDisks_MouseLeftButtonUp">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Background" Value="#E8F4FC"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Selecionado" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="95"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding DiskIcon}" Width="45" IsReadOnly="True"/>
                <DataGridTextColumn Header="Disco" Binding="{Binding Number}" Width="50" IsReadOnly="True"/>
                <DataGridTextColumn Header="Nome / Modelo" Binding="{Binding FriendlyName}" Width="210" IsReadOnly="True"/>
                <DataGridTextColumn Header="Tamanho Total" Binding="{Binding SizeGB, StringFormat={}{0} GB}" Width="95" IsReadOnly="True"/>
                
                <!-- Coluna com Barra Gráfica de Ocupação -->
                <DataGridTemplateColumn Header="Espaço Usado" CellTemplate="{StaticResource CapacityProgressTemplate}" Width="160"/>
                
                <DataGridTextColumn Header="Espaço Livre" Binding="{Binding FreeStr}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Letra" Binding="{Binding DriveLetters}" Width="65" IsReadOnly="True"/>
                <DataGridTextColumn Header="Partição" Binding="{Binding PartitionStyle}" Width="75" IsReadOnly="True"/>
                <DataGridTextColumn Header="Status" Binding="{Binding OperationalStatus}" Width="75" IsReadOnly="True"/>
                <DataGridTextColumn Header="Saúde" Binding="{Binding HealthStatus}" Width="75" IsReadOnly="True"/>
                <DataGridTextColumn Header="Somente Leitura" Binding="{Binding ReadOnlyStr}" Width="105" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Ação (Opções) -->
        <GroupBox Grid.Row="4" Header="Ação" Margin="0,10,0,8" Padding="12" FontWeight="SemiBold">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <RadioButton x:Name="RadioCleanOnly" Content="Limpar disco e deixar Não Alocado (equivalente ao clean do BAT)" 
                                 GroupName="Mode" Margin="0,0,0,6"/>
                    <RadioButton x:Name="RadioFormatQuick" Content="Formatação rápida: clean + criar partição + formatar + atribuir letra" 
                                 GroupName="Mode" IsChecked="True"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="20,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="Sistema de arquivos:" Margin="0,0,0,8"/>
                    <TextBlock Text="Rótulo:" Margin="0,0,0,8"/>
                    <TextBlock Text="Letra desejada:"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
                    <ComboBox x:Name="ComboFs" Width="120" Margin="0,0,0,4">
                        <ComboBoxItem Content="NTFS" IsSelected="True"/>
                        <ComboBoxItem Content="exFAT"/>
                        <ComboBoxItem Content="FAT32"/>
                    </ComboBox>
                    <TextBox x:Name="TxtLabel" Text="FORMATADO" Width="120" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ComboDriveLetter" Width="120"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Botões -->
        <DockPanel Grid.Row="5" Margin="0,4,0,4">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="BtnRefresh" Content="Atualizar agora" Click="BtnRefresh_Click" Padding="12,6"/>
                <Button x:Name="BtnSelectAll" Content="Selecionar todos" Click="BtnSelectAll_Click" Padding="12,6" Margin="6,0,0,0"/>
                <Button x:Name="BtnUnselectAll" Content="Desmarcar todos" Click="BtnUnselectAll_Click" Padding="12,6" Margin="6,0,0,0"/>
                <Button x:Name="BtnEject" Content="⏏️ Ejetar USB Selecionado" Click="BtnEject_Click" Padding="12,6" Margin="12,0,0,0" Background="#FEF3C7" Foreground="#92400E" FontWeight="SemiBold"/>
            </StackPanel>

            <Button x:Name="BtnExecute" Content="Executar nos discos selecionados" Click="BtnExecute_Click" 
                    Padding="16,6" FontWeight="Bold" Background="#1B4965" Foreground="White" DockPanel.Dock="Right"/>
        </DockPanel>

        <!-- Progress Bar -->
        <ProgressBar Grid.Row="6" x:Name="Progress" Height="6" IsIndeterminate="True" Visibility="Collapsed" Margin="0,4,0,4"/>

        <!-- Status -->
        <TextBlock Grid.Row="7" x:Name="TxtStatus" Text="Iniciando..." Foreground="#4B5563" FontSize="11.5" Margin="0,4,0,0"/>
    </Grid>
</Window>
